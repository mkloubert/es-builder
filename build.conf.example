# EmuStation Builder: configuration template. Copy to build.conf and edit.
# Format: KEY=VALUE, one entry per line. Values are taken literally
# (never executed). Comments only on their own lines, not after values.

# --- System ---------------------------------------------------------------
HOSTNAME=emulationstation
LOCALE=de_DE.UTF-8
TIMEZONE=Europe/Berlin
KEYMAP=de

# Required for image targets: password of the user emulationstation
USER_PASSWORD=
# optional: public SSH key
USER_SSH_PUBKEY=

# --- EmulationStation -------------------------------------------------
# Start EmulationStation by itself after boot: yes or no (default: no).
# With no, tty1 shows a shell and a hint how to start it.
ES_AUTOSTART=no

# --- Web UI (https://<device>:11944) -------------------------------
WEB_USER=zocken
WEB_PASSWORD=zocken
# optional: extra names/IPs in the certificate, e.g. emulationstation.fritz.box,192.168.178.50
TLS_EXTRA_SANS=

# Source code link in the footer of the web UI (AGPL-3.0 section 13). http(s) only;
# empty = no link. Default: upstream repository (for a fork, enter your own URL).
SOURCE_URL=https://github.com/mkloubert/es-builder

# --- Wi-Fi (optional; empty = LAN/DHCP only) -----------------------------------
# WIFI_COUNTRY: two capital letters. On the Raspberry Pi it is needed for Wi-Fi
# (Raspberry Pi OS blocks Wi-Fi until a country is set).
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=DE

# --- Scraper (optional) -----------------------------------------------------
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# --- Upstream pins (state of research: 2026-10-31) -------------------------
# Checksums: sha256:<hex> or sha512:<hex>

# Raspberry Pi OS Lite arm64 (bookworm, oldstable), Release 2026-10-06
RPI_IMAGE_URL=https://downloads.raspberrypi.com/raspios_oldstable_lite_arm64/images/raspios_oldstable_lite_arm64-2026-10-06/2026-10-06-raspios-bookworm-arm64-lite.img.xz
RPI_IMAGE_CHECKSUM=sha256:9e938c5a6981c3f498b3b564c527f3e1fd58ef20bbf703be0eea748384a6c1af

# Debian 12 (bookworm) nocloud, UEFI, format .raw, dated directory 20261026-2643
# (Debian publishes only SHA512SUMS)
VM_IMAGE_URL_AMD64=https://cloud.debian.org/images/cloud/bookworm/20261026-2643/debian-12-nocloud-amd64-20261026-2643.raw
VM_IMAGE_CHECKSUM_AMD64=sha512:728546720db094ab840752214b83cf834e08b9848b5f4b2a9aa4bfbf740cf9b7ab95cc414172d8a729555bccd8c4995ab8a6223b0c19b769bd83fe3897570667
VM_IMAGE_URL_ARM64=https://cloud.debian.org/images/cloud/bookworm/20261026-2643/debian-12-nocloud-arm64-20261026-2643.raw
VM_IMAGE_CHECKSUM_ARM64=sha512:e564abc9f96f9e691cb212227bab576bae6fce3b2ad2c7918734ae056278cb0f6f8e47bbda4f30ba4a00d6ffc06db86c8f132889889b737c81c40fdb6f64954f

# RetroPie-Setup, master on 2026-10-23
RETROPIE_SETUP_REF=f5ebfba638179631d4619f2b52075dec33d4bca8
