# Root helper for the web UI. Called as: sudo -n /usr/local/lib/emulationstation/priv <cmd> [arg]
# Commands: reboot, poweroff, apt-update, apt-upgrade, f2b-list, f2b-unban <ip>, journal <unit>,
# usb-list, usb-mount <device>, usb-umount, cpu-set <max|1200|1000|800|600>, cpu-apply,
# cpu-throttled, webui-install <x.y.z>.
# Exit codes: 2 = usage error or invalid argument; 3 = the USB devices could not be read (usb-list,
# usb-mount) or the throttle state could not be read (cpu-throttled); other codes come from the
# command that ran. webui-install also uses 1 when the install unit is busy or cannot start.
#
# Deviation from the project shebang rule (#!/usr/bin/env bash): this script runs as root, so it
# uses the fixed path /bin/bash and does not look up bash through PATH.
set -euo pipefail

# Do not trust the caller's PATH. Tests may set PRIV_TEST_PATH, but only when not running as root.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ "$EUID" -ne 0 ] && [ -n "${PRIV_TEST_PATH:-}" ]; then
  PATH=$PRIV_TEST_PATH
fi
export PATH

usage() {
  printf 'priv: %s\n' "$1" >&2
  printf 'Usage: priv reboot|poweroff|apt-update|apt-upgrade|f2b-list|f2b-unban <ip>|journal <unit>|usb-list|usb-mount <device>|usb-umount|cpu-set <max|1200|1000|800|600>|cpu-apply|cpu-throttled|webui-install <version>\n' >&2
  exit 2
}

# valid_ipv4 <string> : four decimal octets, 0-255, no leading zeros (except "0")
valid_ipv4() {
  local re='^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$'
  local i
  [[ $1 =~ $re ]] || return 1
  for i in 1 2 3 4; do
    [ "${BASH_REMATCH[i]}" -le 255 ] || return 1
  done
}

# valid_ipv6 <string> : hex groups (1-4 digits) with at most one "::", at most 8 groups.
# Embedded IPv4 (::ffff:1.2.3.4) is not accepted.
valid_ipv6() {
  local s=$1 head tail g h t
  [[ $s =~ ^[0-9A-Fa-f:]+$ ]] || return 1
  [[ $s != *:::* ]] || return 1
  if [[ $s == *::* ]]; then
    head=${s%%::*}
    tail=${s#*::}
    [[ $tail != *::* ]] || return 1
    [[ $head != :* && $head != *: && $tail != :* && $tail != *: ]] || return 1
    IFS=: read -r -a h <<<"$head"
    IFS=: read -r -a t <<<"$tail"
    # "::" stands for at least one group of zeros
    [ $((${#h[@]} + ${#t[@]})) -le 7 ] || return 1
    for g in "${h[@]}" "${t[@]}"; do
      [[ $g =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
    done
  else
    [[ $s != :* && $s != *: ]] || return 1
    IFS=: read -r -a h <<<"$s"
    [ "${#h[@]}" -eq 8 ] || return 1
    for g in "${h[@]}"; do
      [[ $g =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
    done
  fi
}

valid_ip() { valid_ipv4 "$1" || valid_ipv6 "$1"; }

# The mount point is owned by root, outside /run/emulationstation (which the web user owns).
# Tests may move it with PRIV_TEST_MOUNT_DIR, but only when not running as root.
USB_MOUNT_DIR=/run/emulationstation-usb
if [ "$EUID" -ne 0 ] && [ -n "${PRIV_TEST_MOUNT_DIR:-}" ]; then
  USB_MOUNT_DIR=$PRIV_TEST_MOUNT_DIR
fi

# usb_check_dir : refuse a mount point that is a symlink or not a plain directory (missing is fine)
usb_check_dir() {
  if [ -L "$USB_MOUNT_DIR" ]; then
    printf 'priv: mount point is a symbolic link\n' >&2
    exit 1
  fi
  if [ -e "$USB_MOUNT_DIR" ] && [ ! -d "$USB_MOUNT_DIR" ]; then
    printf 'priv: mount point is not a directory\n' >&2
    exit 1
  fi
}

# usb_list : prints one line per usable USB partition: <path> TAB <fstype> TAB <size-bytes> TAB <label>
# Candidates: a partition of a USB disk, or a USB disk without partitions, with vfat, exfat or ntfs.
# The disk that holds "/" is never listed (the Pi may boot from a USB SSD). When the root source is
# unknown (findmnt fails or prints nothing), nothing is listed and it returns 1 (the command exits 3).
usb_list() {
  local json root_src
  json=$(lsblk -J -b -o PATH,PKNAME,TRAN,FSTYPE,SIZE,LABEL,TYPE,MOUNTPOINTS) || return 1
  if ! root_src=$(findmnt -n -o SOURCE / 2>/dev/null) || [ -z "$root_src" ]; then
    printf 'priv: could not find the root disk\n' >&2
    return 1
  fi
  root_src=${root_src%%\[*}
  # lsblk prints a flat list (partitions with "pkname", no "children") when the NAME column is
  # not asked for; nest builds the children from pkname then (spec usb-import 9)
  printf '%s' "$json" | jq -r --arg root "$root_src" --arg mnt "$USB_MOUNT_DIR" '
    def subtree: [., ((.children // [])[] | subtree)] | flatten;
    def has_root: any(subtree[]; .path == $root or any((.mountpoints // [])[]; . == "/"));
    def nest: (.blockdevices // []) as $all
      | if any($all[]; has("children")) then $all
        else [$all[] | select(.pkname == null)
              | . as $d | (($d.path // "") | sub("^/dev/"; "")) as $n
              | $d + {children: [$all[] | select(.pkname != null and .pkname == $n)]}]
        end;
    nest[]
    | select(.tran == "usb" and (has_root | not))
    | . as $disk
    | subtree[]
    | select(
        (.type == "part" and ($disk.children // []) != [])
        or (.type == "disk" and .path == $disk.path and (($disk.children // []) | length) == 0)
      )
    | select(all((.mountpoints // [])[]; . == null or . == $mnt))
    | select((.fstype // "") | test("^(vfat|exfat|ntfs)$"))
    | select((.path // "") | test("^/dev/[a-z0-9]+$"))
    | [.path, .fstype, ((.size // 0) | tonumber | floor | tostring),
       (((.label // "") | gsub("[[:cntrl:]]"; "?")) | if . == "" then "-" else . end)]
    | join("\t")'
}

# usb_mounted : succeeds when something is mounted on the USB mount point
usb_mounted() { usb_check_dir; [ -d "$USB_MOUNT_DIR" ] && mountpoint -q "$USB_MOUNT_DIR"; }

# usb_umount : sync, unmount, and use a lazy unmount when the normal one fails
usb_umount() {
  usb_mounted || return 0
  sync -f "$USB_MOUNT_DIR" || true
  if ! umount "$USB_MOUNT_DIR" && ! umount -l "$USB_MOUNT_DIR"; then
    printf 'priv: could not unmount the USB stick\n' >&2
    return 1
  fi
}

# CPU speed limit (spec 2026-10-31-cpu-limit-design.md). The saved value lives in /var/lib, because
# /etc is read-only in the web service's namespace (ProtectSystem=full). Tests may move /sys and
# /proc (PRIV_TEST_SYS) and the state folder (PRIV_TEST_STATE), but only when not running as root.
CPU_SYS=
CPU_STATE=/var/lib/emulationstation-cpu
CPU_OWNER=(-o root -g root)
if [ "$EUID" -ne 0 ]; then
  if [ -n "${PRIV_TEST_SYS:-}" ]; then CPU_SYS=$PRIV_TEST_SYS; fi
  if [ -n "${PRIV_TEST_STATE:-}" ]; then
    CPU_STATE=$PRIV_TEST_STATE
    CPU_OWNER=()
  fi
fi
CPU_FREQ=$CPU_SYS/sys/devices/system/cpu/cpufreq

# cpu_supported : a Raspberry Pi 4 board with cpufreq
cpu_supported() {
  local model
  model=$(tr -d '\0' <"$CPU_SYS/proc/device-tree/model" 2>/dev/null) || return 1
  [[ $model == "Raspberry Pi 4"* ]] && [ -f "$CPU_FREQ/policy0/scaling_max_freq" ] &&
    [ ! -L "$CPU_FREQ/policy0" ]
}

# cpu_khz <value> : prints the kHz for a value of the fixed list; fails for anything else or a
# speed above the board top speed
cpu_khz() {
  local hw mhz
  hw=$(cat "$CPU_FREQ/policy0/cpuinfo_max_freq" 2>/dev/null) || return 1
  [[ $hw =~ ^[1-9][0-9]{0,8}$ ]] || return 1
  case "$1" in
    max) printf '%s\n' "$hw"; return 0 ;;
    1200 | 1000 | 800 | 600) mhz=$1 ;;
    *) return 1 ;;
  esac
  [ $((mhz * 1000)) -le "$hw" ] || return 1
  printf '%s\n' $((mhz * 1000))
}

# cpu_write <khz> : writes scaling_max_freq of every policy; symlinks are skipped
cpu_write() {
  local p
  for p in "$CPU_FREQ"/policy[0-9]*; do
    if [ ! -d "$p" ] || [ -L "$p" ] || [ ! -f "$p/scaling_max_freq" ] || [ -L "$p/scaling_max_freq" ]; then
      continue
    fi
    printf '%s\n' "$1" >"$p/scaling_max_freq" || return 1
  done
}

# cpu_save <value> : saves the value with a temp file and rename
cpu_save() {
  local tmp
  install -d -m 0755 "${CPU_OWNER[@]}" "$CPU_STATE" || return 1
  tmp=$(mktemp "$CPU_STATE/.max-mhz.XXXXXX") || return 1
  if ! { printf '%s\n' "$1" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$CPU_STATE/max-mhz"; }; then
    rm -f "$tmp"
    return 1
  fi
}

# Web UI self-update (spec 2026-11-02-webui-self-update-design.md, section 3.5). The staged binary is
# written by the web user, so every check is done again here, on the root copy too. Tests may move
# the folders and the owner name (PRIV_TEST_*), but only when not running as root.
WI_UPDATE=/var/lib/emulationstation-web/update
WI_INSTALL=/var/lib/emulationstation-webui-install
WI_USER=emulationstation
WI_OWNER=(-o root -g root)
if [ "$EUID" -ne 0 ]; then
  if [ -n "${PRIV_TEST_UPDATE:-}" ]; then WI_UPDATE=$PRIV_TEST_UPDATE; fi
  if [ -n "${PRIV_TEST_INSTALL:-}" ]; then
    WI_INSTALL=$PRIV_TEST_INSTALL
    WI_OWNER=()
  fi
  if [ -n "${PRIV_TEST_USER:-}" ]; then WI_USER=$PRIV_TEST_USER; fi
fi
WI_MAX_BYTES=104857600

# wi_elf_ok <file> : a 64-bit little endian ELF file for the own CPU (header read with od)
wi_elf_ok() {
  local hex machine
  case "$(uname -m)" in
    x86_64) machine=3e00 ;;
    aarch64) machine=b700 ;;
    *) return 1 ;;
  esac
  hex=$(head -c 20 -- "$1" | od -An -tx1 -v | tr -d ' \n') || return 1
  [ "${#hex}" -eq 40 ] || return 1
  [ "${hex:0:8}" = 7f454c46 ] && [ "${hex:8:2}" = 02 ] && [ "${hex:10:2}" = 01 ] &&
    [ "${hex:36:4}" = "$machine" ]
}

# wi_regular <file> : not a symlink and a regular file
wi_regular() { [ ! -L "$1" ] && [ -f "$1" ]; }

# wi_source_ok <file> : regular file, owned by the web user, one link, at most 100 MB
wi_source_ok() {
  local owner links size kind
  [ ! -L "$1" ] || return 1
  read -r owner links size kind < <(stat -c '%U %h %s %F' -- "$1") || return 1
  [ "$kind" = "regular file" ] || [ "$kind" = "regular empty file" ] || return 1
  [ "$owner" = "$WI_USER" ] && [ "$links" = 1 ] || return 1
  [[ $size =~ ^[0-9]{1,12}$ ]] && [ "$size" -le "$WI_MAX_BYTES" ]
}

[ $# -ge 1 ] || usage "missing command"
cmd=$1
shift

# no_args : the command takes no argument
no_args() { [ $# -eq 0 ] || usage "'$cmd' takes no argument"; }

case "$cmd" in
  reboot)
    no_args "$@"
    exec systemctl reboot
    ;;
  poweroff)
    no_args "$@"
    exec systemctl poweroff
    ;;
  # apt runs in its own transient unit. The web service runs with ProtectSystem=full and a
  # control group that systemd kills when the service stops; dpkg must not die with it.
  apt-update)
    no_args "$@"
    exec systemd-run --wait --pipe --collect --quiet \
      --setenv=DEBIAN_FRONTEND=noninteractive -- apt-get update
    ;;
  # --force-conf*: /etc/nftables.conf is replaced by the image (a dpkg conffile); keep our version
  # and never ask a question (there is no terminal).
  apt-upgrade)
    no_args "$@"
    exec systemd-run --wait --pipe --collect --quiet \
      --setenv=DEBIAN_FRONTEND=noninteractive -- apt-get -y \
      -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold upgrade
    ;;
  f2b-list)
    no_args "$@"
    status=$(fail2ban-client status)
    jails=$(printf '%s\n' "$status" | sed -n 's/^.*Jail list:[[:space:]]*//p' | tr ',' ' ')
    for jail in $jails; do
      # jail names come from fail2ban; accept only plain names
      [[ $jail =~ ^[A-Za-z0-9_.-]+$ ]] || continue
      jstatus=$(fail2ban-client status "$jail")
      ips=$(printf '%s\n' "$jstatus" | sed -n 's/^.*Banned IP list:[[:space:]]*//p')
      for ip in $ips; do
        printf '%s %s\n' "$jail" "$ip"
      done
    done
    ;;
  f2b-unban)
    [ $# -eq 1 ] || usage "'f2b-unban' needs one IP address"
    valid_ip "$1" || usage "invalid IP address"
    exec fail2ban-client unban "$1"
    ;;
  journal)
    [ $# -eq 1 ] || usage "'journal' needs one unit name"
    case "$1" in
      emulationstation-web | ssh | fail2ban) ;;
      *) usage "unit not allowed" ;;
    esac
    exec journalctl -u "$1" -n 500 --no-pager
    ;;
  usb-list)
    no_args "$@"
    if ! usb_list; then
      printf 'priv: could not read the USB devices\n' >&2
      exit 3
    fi
    ;;
  usb-mount)
    [ $# -eq 1 ] || usage "'usb-mount' needs one device path"
    [[ $1 =~ ^/dev/[a-z0-9]+$ ]] || usage "invalid device path"
    # Check again against a fresh list. Do not trust the caller. A failing list is a system error
    # (exit 3), not a sign that the device is not a usable stick (exit 2).
    if ! list=$(usb_list); then
      printf 'priv: could not read the USB devices\n' >&2
      exit 3
    fi
    found=
    while IFS=$'\t' read -r dev fstype _; do
      if [ "$dev" = "$1" ]; then
        found=$fstype
        break
      fi
    done <<<"$list"
    [ -n "$found" ] || usage "device is not a usable USB stick"
    case "$found" in
      vfat | exfat) fs_type=$found ;;
      ntfs) fs_type=ntfs3 ;;
      *) usage "file system not supported" ;;
    esac
    usb_umount || exit 1
    usb_check_dir
    if [ ! -e "$USB_MOUNT_DIR" ]; then
      install -d -m 0755 -o root -g root "$USB_MOUNT_DIR"
    fi
    usb_check_dir
    opts="rw,nodev,nosuid,noexec,noatime,uid=$(id -u emulationstation),gid=$(id -g emulationstation),fmask=0137,dmask=0027"
    mount -t "$fs_type" -o "$opts" -- "$1" "$USB_MOUNT_DIR" || exit 1
    printf '%s\n' "$USB_MOUNT_DIR"
    ;;
  usb-umount)
    no_args "$@"
    usb_umount
    ;;
  cpu-set)
    [ $# -eq 1 ] || usage "'cpu-set' needs one value"
    case "$1" in
      max | 1200 | 1000 | 800 | 600) ;;
      *) usage "invalid cpu speed" ;;
    esac
    cpu_supported || usage "cpu limit is not supported on this device"
    khz=$(cpu_khz "$1") || usage "cpu speed is above the board top speed"
    cpu_write "$khz" || exit 1
    cpu_save "$1" || exit 1
    ;;
  # Runs at boot (emulationstation-cpu.service). It never fails the boot for a bad saved value.
  cpu-apply)
    no_args "$@"
    cpu_supported || exit 0
    if [ ! -f "$CPU_STATE/max-mhz" ] || [ -L "$CPU_STATE/max-mhz" ]; then
      exit 0
    fi
    value=$(head -c 16 "$CPU_STATE/max-mhz" | tr -d '\n')
    if ! khz=$(cpu_khz "$value"); then
      printf 'priv: saved cpu limit is not valid, it is ignored\n' >&2
      exit 0
    fi
    cpu_write "$khz" || exit 1
    ;;
  # The throttle bits of the firmware. The sysfs file get_throttled is gone in the rpi-6.12 kernel,
  # and the web user has no access to /dev/vcio, so vcgencmd runs here. Only a checked value is printed.
  cpu-throttled)
    no_args "$@"
    cpu_supported || usage "cpu limit is not supported on this device"
    if ! out=$(vcgencmd get_throttled 2>/dev/null) || [[ ! $out =~ ^throttled=(0x[0-9a-fA-F]{1,8})$ ]]; then
      printf 'priv: could not read the throttle state\n' >&2
      exit 3
    fi
    printf '%s\n' "${BASH_REMATCH[1]}"
    ;;
  # Copies the staged binary to a root folder, checks the copy, and starts the install script in
  # its own unit (the web service restarts during the install and must not stop it).
  webui-install)
    [ $# -eq 1 ] || usage "'webui-install' needs one version"
    ver_re='^(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})\.(0|[1-9][0-9]{0,5})$'
    [[ $1 =~ $ver_re ]] || usage "invalid version"
    wi_src=$WI_UPDATE/emulationstation-web
    wi_source_ok "$wi_src" || usage "the update file is not allowed"
    if systemctl is-active --quiet emulationstation-webui-install; then
      printf 'priv: an install is already running\n' >&2
      exit 1
    fi
    install -d -m 0700 "${WI_OWNER[@]}" "$WI_INSTALL" || exit 1
    rm -f -- "$WI_INSTALL/new" "$WI_INSTALL/new.tmp"
    # The web user can grow the file or swap in a FIFO after the checks. Limit the size and the time.
    # A copy that fails or takes too long is refused with exit 2.
    if ! (ulimit -f $((WI_MAX_BYTES / 1024)) && exec timeout 120 cp --no-dereference -- "$wi_src" "$WI_INSTALL/new.tmp"); then
      rm -f -- "$WI_INSTALL/new.tmp"
      usage "the update file could not be copied"
    fi
    if ! wi_regular "$WI_INSTALL/new.tmp" || [ "$(wc -c <"$WI_INSTALL/new.tmp")" -gt "$WI_MAX_BYTES" ] ||
      ! wi_elf_ok "$WI_INSTALL/new.tmp"; then
      rm -f -- "$WI_INSTALL/new.tmp"
      usage "the update file is not a program for this device"
    fi
    # Only now, after the -L check, the copy is stable (the folder is root only): set the mode.
    chmod 0755 -- "$WI_INSTALL/new.tmp" || { rm -f -- "$WI_INSTALL/new.tmp"; exit 1; }
    mv -f -- "$WI_INSTALL/new.tmp" "$WI_INSTALL/new" || exit 1
    systemd-run --unit=emulationstation-webui-install --collect --no-block \
      /usr/local/lib/emulationstation/webui-install "$1" || exit 1
    ;;
  *) usage "unknown command" ;;
esac
