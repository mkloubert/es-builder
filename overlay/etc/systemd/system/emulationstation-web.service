# Web service of EmuStation Builder (HTTPS on port 11944). It runs as the user emulationstation.
# NoNewPrivileges=no is needed: the service calls the sudo helper (/usr/local/lib/emulationstation/priv).
# That is why there is no PrivateDevices, no RestrictSUIDSGID and no CapabilityBoundingSet here.
[Unit]
Description=EmuStation web service
Wants=network-online.target
After=network-online.target emulationstation-firstboot.service

[Service]
Type=simple
User=emulationstation
ExecStart=/usr/local/bin/emulationstation-web serve --config /etc/emulationstation-web/web.conf
StateDirectory=emulationstation-web
Restart=on-failure
AmbientCapabilities=
NoNewPrivileges=no
ProtectSystem=full
ReadWritePaths=/etc/emulationstation-web /home/emulationstation /run/emulationstation

[Install]
WantedBy=multi-user.target
