# Applies the saved top CPU speed at boot (Raspberry Pi 4 only; enabled by provision/rpi4/app-10-cpu.sh).
# It runs once and opens nothing. See docs/superpowers/specs/2026-10-31-cpu-limit-design.md.
[Unit]
Description=EmuStation CPU speed limit
After=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/emulationstation/priv cpu-apply

[Install]
WantedBy=multi-user.target
