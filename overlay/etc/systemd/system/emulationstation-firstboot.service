# First boot setup. It runs at EVERY boot (no ConditionPathExists): it makes the SSH host keys,
# grows the root partition (VM only, once) and applies emulationstation.txt from the boot
# partition if the file exists. It runs before the network, the web service and ssh.
# RequiresMountsFor= for the boot partition comes from the drop-in written by
# provision/common/app-40-firstboot.sh (the path differs per target).
# ssh.socket is not ordered here on purpose: it is disabled in the image, and with the default
# dependencies of this unit an order before ssh.socket would make a cycle (sockets.target).
# Raspberry Pi OS has its own regenerate_ssh_host_keys.service (removes the keys and runs
# ssh-keygen -A). This unit waits for it, so the two never make keys at the same time. On the VM
# that unit does not exist; then the order has no effect.
[Unit]
Description=EmuStation first boot setup
After=local-fs.target regenerate_ssh_host_keys.service
Before=network-pre.target emulationstation-web.service ssh.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=10min
ExecStart=/usr/local/lib/emulationstation/firstboot

[Install]
WantedBy=multi-user.target
